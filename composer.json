{
    "name": "aleoosha/telemetry-contracts",
    "description": "Contracts and DTOs for system telemetry and state management",
    "license": "MIT",
    "type": "library",
    "autoload": {
        "psr-4": { "Aleoosha\\Telemetry\\Contracts\\": "src/" }
    },
    "require": {
        "php": "^8.1",
        "aleoosha/support-types": "dev-main"
    },
    "require-dev": {
        "pestphp/pest": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Aleoosha/support-types"
        }
    ]
}
